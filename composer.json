{
	"name": "themehybrid/hybrid-tools",
	"description": "Helper tools and functions.",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress"
	],
	"authors": [
		{
			"name": "Theme Hybrid",
			"email": "themehybrid@gmail.com",
			"homepage": "https://themehybrid.com",
			"role": "Developer"
		}
	],
	"homepage": "https://github.com/themehybrid/hybrid-tools",
	"support": {
		"issues": "https://github.com/themehybrid/hybrid-tools/issues",
		"forum": "https://themehybrid.com/board/forums/hybrid-core"
	},
	"require": {
		"php": ">=8.2",
		"ext-ctype": "*",
		"ext-filter": "*",
		"league/commonmark": "^2.8.1",
		"nesbot/carbon": "^3.8.4",
		"ramsey/uuid": "^4.7",
		"symfony/polyfill-php82": "^1.33",
		"symfony/polyfill-php83": "^1.33",
		"symfony/polyfill-php84": "^1.33",
		"symfony/polyfill-php85": "^1.33",
		"symfony/uid": "^7.4 || ^8.0.0",
		"vlucas/phpdotenv": "^5.6.1",
		"voku/portable-ascii": "^2.0.2"
	},
	"require-dev": {
		"alvarodelera/pest-wp-plugin": "^2.0",
		"pestphp/pest": "^5.0",
		"themehybrid/hybrid-contracts": "^2.0",
		"themehybrid/hybrid-core": "dev-dev as 7.0"
	},
	"replace": {
		"spatie/once": "*"
	},
	"suggest": {
		"symfony/var-dumper": "Required to use the dump method (^7.4.7).",
		"themehybrid/hybrid-serializable-closure": "Required to use the Onceable (^1.0)."
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"autoload": {
		"psr-4": {
			"Hybrid\\Tools\\": "src/"
		},
		"files": [
			"src/functions-helpers.php",
			"src/WordPress/functions-helpers.php"
		]
	},
	"autoload-dev": {
		"psr-4": {
			"Hybrid\\Tools\\Tests\\": "tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"pestphp/pest-plugin": true
		},
		"sort-packages": true
	},
	"extra": {
		"branch-alias": {
			"dev-master": "2.0.x-dev"
		}
	},
	"scripts": {
		"test": "pest"
	}
}
